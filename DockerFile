# Шаг 1: Сборка кастомной JRE (Tree Shaking)
FROM docker.io/library/eclipse-temurin:21-jdk-alpine AS jre-builder

RUN $JAVA_HOME/bin/jlink \
    --add-modules \
java.base,\
java.sql,\
java.naming,\
java.management,\
java.logging,\
jdk.httpserver,\
jdk.crypto.ec,\
jdk.unsupported \
    --strip-debug \
    --no-man-pages \
    --no-header-files \
    --compress=zip-9 \
    --output /javaruntime

# Шаг 2: Финальный легковесный образ
FROM docker.io/library/alpine:latest
WORKDIR /app

# Устанавливаем совместимость с glibc (критично для нативной либки SQLite в Alpine)
RUN apk add --no-cache gcompat libstdc++

# Копируем кастомную JRE и твой JAR
COPY --from=jre-builder /javaruntime /javaruntime
COPY limserver-chr-small.jar /app/limserver.jar

# Создаем папки для монтирования (чтобы права доступа были верные)
RUN mkdir -p /app/db /app/media

# Запуск с ограничением памяти для роутера
CMD ["/javaruntime/bin/java", \
     "-Dsun.net.httpserver.maxReqTime=180", \
     "-Dsun.net.httpserver.maxRspTime=180", \
     "-Dsun.net.httpserver.nodelay=true", \
     "-Xms32m", "-Xmx96m", \
     "-jar", "/app/limserver.jar"]





     # Шаг 1: Сборка кастомной JRE (Tree Shaking)
     FROM docker.io/library/eclipse-temurin:21-jdk-alpine AS jre-builder

     RUN $JAVA_HOME/bin/jlink \
         --add-modules \
     java.base,\
     java.sql,\
     java.naming,\
     java.management,\
     java.logging,\
     jdk.httpserver,\
     jdk.crypto.ec,\
     jdk.unsupported \
         --strip-debug \
         --no-man-pages \
         --no-header-files \
         --compress=zip-9 \
         --output /javaruntime

     # Шаг 2: Финальный легковесный образ
     FROM docker.io/library/alpine:latest
     WORKDIR /app

     # Устанавливаем совместимость с glibc (критично для нативной либки SQLite в Alpine)
     RUN apk add --no-cache gcompat libstdc++

     # Копируем кастомную JRE и твой JAR
     COPY --from=jre-builder /javaruntime /javaruntime
     COPY build/libs/limserver-chr-small.jar /app/limserver.jar

     # Создаем папки для монтирования (чтобы права доступа были верные)
     RUN mkdir -p /app/db /app/media

     # Запуск с ограничением памяти для роутера
     CMD ["/javaruntime/bin/java", \
          "-Dsun.net.httpserver.maxReqTime=180", \
          "-Dsun.net.httpserver.maxRspTime=180", \
          "-Dsun.net.httpserver.nodelay=true", \
          "-Xms32m", "-Xmx96m", \
          "-jar", "/app/limserver.jar"]




          name: Publish Lim Server Multi-Arch

          on:
            push:
              branches: [ "master" ]
              paths:
                - 'limserver/build.gradle.kts'
            workflow_dispatch:

          jobs:
            build-and-push:
              runs-on: ubuntu-latest
              permissions:
                contents: read
                packages: write

              steps:
                - name: Checkout repository
                  uses: actions/checkout@v5

                - name: Set up QEMU
                  uses: docker/setup-qemu-action@v4

                - name: Set up Docker Buildx
                  uses: docker/setup-buildx-action@v4

                - name: Set up JDK 21
                  uses: actions/setup-java@v5
                  with:
                    java-version: '21'
                    distribution: 'temurin'
                    cache: gradle

                - name: Grant execute permission for gradlew
                  run: chmod +x gradlew

                - name: Build Minified Jar
                  run: ./gradlew :limserver:minifyJar

                - name: Extract version from Gradle
                  id: get_version
                  run: |
                    VERSION=$(./gradlew :limserver:properties | grep ^version: | awk '{print $2}')
                    echo "VERSION=$VERSION" >> $GITHUB_OUTPUT

                - name: Log in to the Container registry
                  uses: docker/login-action@v4
                  with:
                    registry: ghcr.io
                    username: ${{ github.actor }}
                    password: ${{ secrets.GITHUB_TOKEN }}

                - name: Build and push Multi-Arch Image
                  uses: docker/build-push-action@v7
                  with:
                    context: ./limserver
                    platforms: linux/amd64,linux/arm64
                    push: true
                    provenance: false
                    sbom: false
                    tags: |
                      ghcr.io/safelogj/lim-server:latest
                      ghcr.io/safelogj/lim-server:${{ steps.get_version.outputs.VERSION }}
