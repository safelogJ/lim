FROM --platform=linux/arm/v7 docker.io/arm32v7/eclipse-temurin:17-jdk-resolute AS jre-builder

RUN echo "=== SYSTEM ===" && \
    uname -a && \
    echo "=== JAVA ===" && \
    java -version && \
    echo "=== JLINK ===" && \
    $JAVA_HOME/bin/jlink --version

RUN $JAVA_HOME/bin/jlink \
    --add-modules \
java.base,\
java.sql,\
java.naming,\
java.management,\
java.logging,\
jdk.httpserver,\
jdk.crypto.ec,\
jdk.unsupported \
    --strip-debug \
    --no-man-pages \
    --no-header-files \
    --compress=0 \
    --output /javaruntime

FROM --platform=linux/arm/v7 docker.io/library/debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=jre-builder /javaruntime /javaruntime
COPY build/libs/limserver-chr-small.jar /app/limserver.jar

RUN mkdir -p /app/db /app/media

CMD ["/javaruntime/bin/java", \
    "-Dsun.net.httpserver.maxReqTime=180", \
    "-Dsun.net.httpserver.maxRspTime=180", \
    "-Dsun.net.httpserver.nodelay=true", \
    "-Xms32m", "-Xmx96m", \
    "-jar", "/app/limserver.jar"]