<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/interlocutor_bubble_blue_b" />
            <corners android:radius="42dp" />
            <stroke
                android:width="2dp"
                android:color="@color/main_background" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="4dp"
        android:right="4dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="@color/interlocutor_bubble_blue"
                android:endColor="@color/interlocutor_bubble_blue_b"
                android:startColor="@color/interlocutor_bubble_blue_b"
                android:type="linear" />
            <corners android:radius="33dp" />
        </shape>
    </item>
</layer-list>

